# Copier ce fichier en backend/.env puis remplir les valeurs.
DATABASE_URL=postgresql+psycopg2://cherrat:cherrat_pwd@localhost:5432/cherrat_stock
# Clé de signature des jetons JWT : python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
# llama3.2:3b pour un PC de 8 Go de RAM, llama3.1:8b si 16 Go
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
# Clé partagée avec n8n (en-tête X-API-Key) : python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTOMATION_API_KEY=a-remplacer
